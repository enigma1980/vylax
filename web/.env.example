# Cadena de conexión a PostgreSQL
DATABASE_URL=postgresql://vylax:CONTRASEÑA@localhost:5432/vylax

# true si la API está detrás de un proxy de confianza (p. ej. Nginx, Vercel)
# que añade el header X-Forwarded-For con la IP real del cliente.
TRUST_PROXY=false

# Clave AES-256-GCM para cifrar los secretos TOTP (obligatorio).
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Debe tener exactamente 64 caracteres hexadecimales (32 bytes).
VYLAX_ENCRYPTION_KEY=

# SMTP para envío de códigos de verificación por correo.
# Si no se configura SMTP_HOST, los códigos se muestran por consola (modo desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Vylax <noreply@vylax.com>
