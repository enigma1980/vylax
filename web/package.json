{
  "name": "vylax-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed.ts",
    "test": "tsx --test test/validators.test.ts",
    "test:integration": "dotenv -e .env.local -- tsx --test test/idempotency.test.ts",
    "db:reset": "dotenv -e .env.local -- tsx scripts/reset.ts",
    "user:create": "dotenv -e .env.local -- tsx scripts/user-create.ts",
    "user:set-password": "dotenv -e .env.local -- tsx scripts/user-set-password.ts",
    "user:reset-2fa": "dotenv -e .env.local -- tsx scripts/user-reset-2fa.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "postgres": "4.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^8",
    "drizzle-kit": "0.31.11",
    "tsx": "^4",
    "typescript": "^5"
  }
}
