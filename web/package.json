{
  "name": "vylax-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed.ts",
    "test": "tsx --test test/validators.test.ts",
    "test:integration": "dotenv -e .env.local -- tsx --test test/idempotency.test.ts",
    "test:auth": "dotenv -e .env.local -- tsx --test test/auth.test.ts",
    "test:search": "dotenv -e .env.local -- tsx --test test/search.test.ts",
    "db:reset": "dotenv -e .env.local -- tsx scripts/reset.ts",
    "user:create": "dotenv -e .env.local -- tsx scripts/user-create.ts",
    "user:set-password": "dotenv -e .env.local -- tsx scripts/user-set-password.ts",
    "user:reset-2fa": "dotenv -e .env.local -- tsx scripts/user-reset-2fa.ts",
    "demo:session": "dotenv -e .env.local -- tsx scripts/create-demo-session.ts",
    "dev:seed-demo": "dotenv -e .env.local -- tsx scripts/seed-demo.ts",
    "test:dashboard": "dotenv -e .env.local -- tsx --test test/device-status.test.ts test/dashboard-isolation.test.ts test/dashboard-overview.test.ts",
    "test:checks": "tsx --test test/device-checks.test.ts",
    "test:enroll": "dotenv -e .env.local -- tsx --test test/enroll-ip-revoke.test.ts",
    "test:clientes": "dotenv -e .env.local -- tsx --test test/clientes.test.ts",
    "test:client-devices": "dotenv -e .env.local -- tsx --test test/client-devices.test.ts",
    "test:sites-tokens": "dotenv -e .env.local -- tsx --test test/sites-tokens.test.ts",
    "test:ajustes-cliente": "dotenv -e .env.local -- tsx --test test/ajustes-cliente.test.ts",
    "test:device-detail": "dotenv -e .env.local -- tsx --test test/device-detail.test.ts",
    "test:device-actions": "dotenv -e .env.local -- tsx --test test/device-actions.test.ts",
    "test:pendientes": "dotenv -e .env.local -- tsx --test test/pendientes.test.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "nodemailer": "^10.6.1",
    "otpauth": "^9.6.0",
    "postgres": "4.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^8",
    "drizzle-kit": "0.31.11",
    "tsx": "^4",
    "typescript": "^5"
  }
}
